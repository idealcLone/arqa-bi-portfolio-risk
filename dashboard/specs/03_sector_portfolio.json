{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Портфель по отраслям на обе даты, млрд ₸. Данные: reporting.v_metrics_by_sector",
  "data": {
    "url": "data/by_sector.json"
  },
  "transform": [
    {
      "calculate": "datum.portfolio_kzt / 1e9",
      "as": "portfolio_bn"
    }
  ],
  "width": 360,
  "height": 290,
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3,
    "tooltip": true
  },
  "encoding": {
    "y": {
      "field": "sector",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "portfolio_bn",
        "op": "max",
        "order": "descending"
      }
    },
    "yOffset": {
      "field": "report_date_label",
      "type": "ordinal",
      "sort": {
        "field": "report_date",
        "op": "min"
      }
    },
    "x": {
      "field": "portfolio_bn",
      "type": "quantitative",
      "title": "Портфель, млрд ₸",
      "axis": {}
    },
    "color": {
      "field": "report_date_label",
      "type": "ordinal",
      "title": "Дата среза",
      "scale": {
        "range": [
          "#a0aec0",
          "#2b6cb0"
        ]
      },
      "legend": {
        "orient": "top"
      },
      "sort": {
        "field": "report_date",
        "op": "min"
      }
    },
    "tooltip": [
      {
        "field": "sector",
        "type": "nominal",
        "title": "Отрасль"
      },
      {
        "field": "report_date_label",
        "type": "ordinal",
        "title": "Дата среза",
        "sort": {
          "field": "report_date",
          "op": "min"
        }
      },
      {
        "field": "portfolio_bn",
        "type": "quantitative",
        "title": "Портфель, млрд ₸",
        "format": ",.2f"
      },
      {
        "field": "share_of_portfolio",
        "type": "quantitative",
        "title": "Доля в портфеле",
        "format": ".2%"
      },
      {
        "field": "loan_count",
        "type": "quantitative",
        "title": "Кредитов"
      }
    ]
  }
}